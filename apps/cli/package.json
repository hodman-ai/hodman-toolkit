{
  "name": "@hodman-ai/cli",
  "version": "0.1.0",
  "private": true,
  "description": "User-authorized CLI for Hodman",
  "license": "MIT",
  "homepage": "https://github.com/hodman-ai/hodman-toolkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hodman-ai/hodman-toolkit.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "hodman": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --external:@napi-rs/keyring --outfile=dist/index.js && chmod 0755 dist/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@hodman-ai/api-client": "^1.0.0",
    "@hodman-ai/api-contract": "^1.0.0",
    "@napi-rs/keyring": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "esbuild": "^0.25.12",
    "typescript": "^5.3.3",
    "vitest": "^4.1.10"
  }
}
